# Выбери одного основного провайдера и одного для судьи (обязательно разных).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
JUDGE_PROVIDER=mistral
JUDGE_MODEL=mistral-small-latest

GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Langfuse (этап M4, пока можно оставить пустым)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
